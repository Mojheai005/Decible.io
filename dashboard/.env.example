# Decible's Supabase project (same values as the main app).
SUPABASE_URL=https://pwjtmtateymujxoaqkne.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The one password everyone uses to open the dashboard. Make it long.
DASHBOARD_PASSWORD=

# Random secret that signs the login cookie (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: most grants (new or moved) the dashboard will make per day (IST). Default 40.
GRANT_DAILY_LIMIT=40

# Optional: where escalations are kept. "supabase" (default) = a private Storage bucket.
# "file" = a local .escalations folder, for running on your own computer only.
ESCALATION_STORE=supabase
ESCALATION_BUCKET=support-escalations

# Optional: Slack / Discord / Google Chat incoming-webhook URL to ping when a problem is escalated.
ESCALATION_WEBHOOK_URL=
